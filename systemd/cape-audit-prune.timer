[Unit]
Description=Run CAPE audit_log prune nightly
Requires=cape-audit-prune.service

[Timer]
OnCalendar=*-*-* 03:00:00
Persistent=true
# Jitter prevents thundering-herd when multiple CAPE deployments share infra.
RandomizedDelaySec=300
Unit=cape-audit-prune.service

[Install]
WantedBy=timers.target
